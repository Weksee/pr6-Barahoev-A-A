digraph ClassDiagram {
    rankdir=TB;
    node [shape=record, fontname="Arial"];

    ApprovalRouter [label="{ApprovalRouter|{
        +FINANCE_LIMIT: long\l
        |+route(long, boolean, RiskLevel, boolean): ApprovalRoute\l
        +addUrgencyFlag(long, boolean): boolean\l
    }}"];

    ApprovalRoute [label="{ApprovalRoute|{
        STANDARD\l
        FAST_TRACK\l
        FINANCE_REVIEW\l
        DIRECTOR_REVIEW\l
        SECURITY_REVIEW\l
    }}"];

    RiskLevel [label="{RiskLevel|{
        LOW\l
        MEDIUM\l
        HIGH\l
    }}"];

    ApprovalRouter -> ApprovalRoute [label="returns"];
    ApprovalRouter -> RiskLevel [label="uses"];
}